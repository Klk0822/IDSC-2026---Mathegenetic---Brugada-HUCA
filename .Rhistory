# =====================================================================
# PART 1: SETUP & PREPROCESSING
# =====================================================================
library(keras3)
library(dplyr)
# 1. Lock down all random number generators
tensorflow::set_random_seed(2026)
tensorflow::install_tensorflow()
install_tensorflow()
install_keras()
