filtered_matrix <- matrix(0, nrow = timesteps, ncol = num_leads)
# Apply the filter to each of the 12 leads individually
for (lead_idx in 1:num_leads) {
raw_signal <- df[[lead_idx]]
# We use 'filtfilt' instead of 'filter' for zero-phase distortion.
# This ensures the timing of the R-peaks doesn't shift left or right!
filtered_matrix[, lead_idx] <- filtfilt(bw_filter, raw_signal)
}
# Store the cleaned matrix into your 3D Keras tensor
X_array[i, , ] <- filtered_matrix
}
cat("Filtered X_array ready. Shape:", dim(X_array), "\n")
#----Plotting----
#Library for plotting
library(ggplot2)
library(tidyr)
library(dplyr)
# Select patient 999474 for plotting
patient_id <- "999474"
# Extract patient's df
patient_df <- ecg_list[[patient_id]]
# Extract the metadata for this specific patient
# We use as.character() just in case the CSV read the IDs as numeric
patient_meta <- md[as.character(md$patient_id) == patient_id, ]
# Format the metadata into a clean subtitle string
# We extract the 0/1 values for basal_pattern, sudden_death, and brugada
meta_subtitle <- sprintf(
"Diagnosis (Brugada): %s  |  Basal Pattern: %s  |  Sudden Death: %s",
ifelse(patient_meta$brugada == 1, "Yes", "No"),
ifelse(patient_meta$basal_pattern == 1, "Yes", "No"),
ifelse(patient_meta$sudden_death == 1, "Yes", "No")
)
# Extract lead names automatically from the column names (excluding the "Time_s" column)
lead_names <- setdiff(colnames(patient_df), "Time_s")
# Reshape the data from 'wide' to 'long' format
ecg_long <- patient_df %>%
pivot_longer(
cols = all_of(lead_names),    # Pivot only the ECG leads, leave Time_s alone
names_to = "Lead",
values_to = "Amplitude"
)
# Lock in the order of the leads so ggplot doesn't alphabetize them
ecg_long$Lead <- factor(ecg_long$Lead, levels = lead_names)
# Generate the faceted plot (Using your calculated Time_s for the X-axis)
ggplot(ecg_long, aes(x = Time_s, y = Amplitude)) +
geom_line(color = "#b22222", linewidth = 0.5) +
facet_wrap(~ Lead, ncol = 3, scales = "free_y") +
theme_minimal() +
labs(
title = sprintf("12-Lead ECG - Patient %s", patient_id),
subtitle = meta_subtitle,                               # <--- Added the metadata here!
x = "Time (seconds)",
y = "Amplitude (mV)"
) +
theme(
plot.subtitle = element_text(size = 11, color = "gray30", margin = margin(b = 10)), # Styles the subtitle
strip.text = element_text(face = "bold", size = 10),
panel.grid.minor = element_blank()
)
#----EDA----
# GEMINI version
library(corrplot)
library(factoextra)
# Ensure patient_id is a character in your metadata for clean merging later
md$patient_id <- as.character(md$patient_id)
# =====================================================================
# PHASE 1: Metadata EDA (The Tabular Base)
# =====================================================================
cat("\n--- PHASE 1: Metadata EDA ---\n")
# 1. Target Class Balance
cat("\nBrugada Class Distribution:\n")
print(table(md$brugada, useNA = "always"))
cat("\nBrugada Class Proportions:\n")
print(prop.table(table(md$brugada)))
# 2. Cross-Tabulation of conditions
cat("\nBrugada vs. Sudden Death Contingency Table:\n")
print(table(Brugada = md$brugada, Sudden_Death = md$sudden_death))
cat("\nBrugada vs. Basal Pattern Contingency Table:\n")
print(table(Brugada = md$brugada, Basal_Pattern = md$basal_pattern))
# =====================================================================
# PHASE 2: Signal Quality & Structural EDA
# =====================================================================
cat("\n--- PHASE 2: Signal Quality Check ---\n")
# 1. Check for Signal Length Consistency across all patients
signal_lengths <- sapply(ecg_list, nrow)
cat("\nSummary of ECG recording lengths (number of samples):\n")
print(summary(signal_lengths))
# 2. Global Amplitude Outlier Check (Max mV across the entire record)
# This finds the maximum absolute value in the matrix (excluding the Time_s column)
get_max_amplitude <- function(df) {
# Drop Time_s to only evaluate the 12 leads
leads_only <- df %>% select(-Time_s)
max(abs(leads_only), na.rm = TRUE)
}
max_amplitudes <- sapply(ecg_list, get_max_amplitude)
cat("\nSummary of Maximum Absolute Amplitudes (mV):\n")
print(summary(max_amplitudes))
# Plot the distribution of max amplitudes to visually spot noisy/detached leads
hist(max_amplitudes, breaks = 50, col = "steelblue",
main = "Distribution of Max ECG Amplitudes",
xlab = "Maximum Absolute Amplitude (mV)")
# =====================================================================
# PHASE 3: Feature Extraction & Bivariate Analysis
# =====================================================================
cat("\n--- PHASE 3: Feature Extraction vs. Labels ---\n")
# 1. Extract Summary Statistics for every patient
# Brugada syndrome primarily manifests in the right precordial leads (V1, V2, V3)
extract_features <- function(id) {
df <- ecg_list[[id]]
data.frame(
patient_id = id,
# Variance (spread of the signal)
V1_var = var(df$V1, na.rm = TRUE),
V2_var = var(df$V2, na.rm = TRUE),
# Maximum amplitude (peak of the QRS/ST segment)
V1_max = max(df$V1, na.rm = TRUE),
V2_max = max(df$V2, na.rm = TRUE),
# Minimum amplitude (depth of the S wave)
V1_min = min(df$V1, na.rm = TRUE),
V2_min = min(df$V2, na.rm = TRUE)
)
}
# Apply the function across all patients and bind into a single dataframe
features_df <- bind_rows(lapply(names(ecg_list), extract_features))
# 2. Merge extracted features with clinical metadata
analysis_df <- left_join(md, features_df, by = "patient_id")
# 3. Visualizing Extracted Features by Diagnosis
# Let's look at the Maximum Amplitude in Lead V1, grouped by Brugada status
p_boxplot <- ggplot(analysis_df, aes(x = as.factor(brugada), y = V1_max, fill = as.factor(brugada))) +
geom_boxplot(alpha = 0.7) +
scale_fill_manual(values = c("#4daf4a", "#e41a1c"), labels = c("Control (0)", "Brugada (1)")) +
theme_minimal() +
labs(
title = "Max Amplitude in Lead V1: Brugada vs. Control",
x = "Diagnosis (0 = No, 1 = Yes)",
y = "Max Amplitude (mV)",
fill = "Diagnosis"
)
print(p_boxplot)
# =====================================================================
# PHASE 4: Dimensionality & Correlation
# =====================================================================
cat("\n--- PHASE 4: Dimensionality & Correlation ---\n")
# 1. Correlation Matrix of the extracted features
# Isolate just the numeric feature columns
feature_cols <- analysis_df %>% select(V1_var:V2_min)
cor_matrix <- cor(feature_cols, use = "complete.obs")
# Plot the correlation heatmap
corrplot(cor_matrix, method = "color", type = "upper",
tl.col = "black", tl.srt = 45,
addCoef.col = "black", number.cex = 0.7,
title = "Correlation Matrix of V1 & V2 Features",
mar = c(0,0,2,0))
# 2. Principal Component Analysis (PCA)
# Scale the data (center = TRUE, scale. = TRUE) because variances and amplitudes are on different scales
pca_result <- prcomp(feature_cols, center = TRUE, scale. = TRUE)
# View the variance explained by each principal component
cat("\nPCA Summary:\n")
print(summary(pca_result))
# Plot the PCA biplot colored by Brugada diagnosis
p_pca <- fviz_pca_ind(pca_result,
geom.ind = "point", # Show points only (no text labels)
col.ind = as.factor(analysis_df$brugada), # Color by Brugada status
palette = c("#4daf4a", "#e41a1c"),
addEllipses = TRUE, # Add concentration ellipses
legend.title = "Brugada",
title = "PCA of Extracted ECG Features") +
theme_minimal()
print(p_pca)
#----Interpretation (EDA)----
# Numerical
# PHASE 1
# Imbalanced Class (287 vs 76) -> Don't use Accuracy as metrics
# Suggestion: rely on metrics like the F1-score, Precision-Recall AUC, or Sensitivity/Specificity, SMOTE or class weighting when training the classifier
# Sudden Death is Rare (11 cases), but Indicative
# 6.6% of Brugada patients (5 out of 76) experienced it, compared to only 2.1% of the Control group (6 out of 287)
# Basal Pattern is a Strong Predictor
# 30% of the Brugada patients (23 out of 76) show a basal pattern, compared to just 8% of the Control group (23 out of 287)
# PHASE 2
# Same Signal Length (Perfect Scenario)
# Clean Amplitudes
# Maximum absolute amplitudes range from 0.696 mV to 3.813 mV. These are completely normal physiological ranges for an ECG
# PHASE 4
# Strong PCA summary
# Principal Component 1 (PC1) captures 57.26% of the total variance in your extracted features, and PC2 captures 19.71%.
# two dimensions explain almost 77% of the information contained in your 6 different features (V1/V2 variance, max, min).
# This means the 2D scatter plot you generated is a highly accurate representation of the data.
# If the red and green dots are separating well on that plot, a machine learning model will have an easy time classifying them.
# Visual
# Histogram shows the maximum absolute millivolt (mV) value recorded across all 12 leads for every patient.
# Roughly normal, slightly right-skewed distribution, with the vast majority of signals peaking between 1.0 mV and 2.5 mV.
# The data is naturally bounded here, likely do not need to apply aggressive outlier-clipping algorithms before training your models.
# Boxplot
# The distributions are virtually identical. The median max amplitude is practically the same for both groups, and the boxes overlap entirely.
# A simple rule like "If the maximum amplitude is > 1.5 mV, it's Brugada" will fail completely.
# Brugada syndrome does not drastically change the overall maximum height of the entire ECG signal,
# it changes the shape of very specific segments (like the ST segment).
# Correlation Heatmap
# V1_var & V1_max (0.73): High variance is strongly driven by high maximum peaks.
# V2_var & V2_min (-0.79): High variance is heavily driven by deep negative troughs (S-waves).
# V1_min & V2_min (0.62): Because V1 and V2 are physically adjacent on the patient's chest, their electrical readings are inherently linked.
# Strong Multicollinearity suggest the features are telling the model the same information.
# Suggestion: use models that handle correlated features well (like Random Forests) or use dimensionality reduction.
# PCA
# Biplot projects your 6-dimensional feature space down into 2D space.
# Principal Component 1 (X-axis) and PC2 (Y-axis) capture 77% of all the mathematical variance in your features.
# The ellipses show the general territory of the two classes.
# The red Brugada ellipse and the green Control ellipse are sitting right on top of each other.
# The classes do not naturally separate based on overall variance, max, and min values.
# Confirms the suspicion (intuition) from the boxplot.
# Simple summary statistics (min, max, variance) destroy the temporal sequence of the data and miss the clinical nuance of Brugada syndrome.
# Conclusion from EDA
# EDA proves that basic statistical summaries are not enough to crack this dataset.
# To build a highly accurate classifier, you will need to level up your feature engineering.
# =====================================================================
# PART 1: SETUP & PREPROCESSING
# =====================================================================
library(keras3)
library(dplyr)
# 1. Lock down all random number generators
set_random_seed(2026)
# Call library for PhysioNet data
library(reticulate)
# Install the Python wfdb package
py_install("wfdb")
# Import the library into R
wfdb <- import("wfdb")
#----Set up working directory-----
wd <- "C:/Users/User/Downloads/IDSC 2026/Brugada_HUCA/Dataset/brugada-huca-12-lead-ecg-recordings-for-the-study-of-brugada-syndrome-1.0.0/files"
setwd(wd)
#----Read in dataset----
# Search for .hea files
hea_files <- list.files(pattern = "\\.hea$", recursive = TRUE)
record_paths <- tools::file_path_sans_ext(hea_files)
# Function to read in the signals
read_ecg_record <- function(path) {
# Read the record using Python's wfdb
record <- wfdb$rdrecord(path)
# Extract the numeric matrix of physical signals (in mV)
signals <- record$p_signal
# Apply the correct lead names to the columns
colnames(signals) <- record$sig_name
# Convert the matrix into a dataframe for easier analysis
df <- as.data.frame(signals)
# Dynamically add a Time column using the sampling frequency (fs) from the header
df$Time_s <- seq(0, by = 1 / record$fs, length.out = nrow(df))
return(df)
}
# Store the signals into a list
ecg_list <- lapply(record_paths, read_ecg_record)
names(ecg_list) <- basename(record_paths)
print(names(ecg_list))
head(ecg_list[["188981"]])
# Metadata CSV
setwd("C:/Users/User/Downloads/IDSC 2026/Brugada_HUCA/Dataset/brugada-huca-12-lead-ecg-recordings-for-the-study-of-brugada-syndrome-1.0.0")
md <- read.csv("metadata.csv")
head(md)
summary(md)
md$basal_pattern <- as.factor(md$basal_pattern)
md$sudden_death <- as.factor(md$sudden_death)
md$brugada <- as.factor(md$brugada)
summary(md)
# We have noticed that there are 7 Brugada patients errorly labelled as 2 instead of 1
# Since it's known that there are 76 Brugada patients in the dataset
md$brugada[md$brugada == 2] <- 1
md$brugada <- factor(md$brugada)
#Baseline Wander Removal (Data Preprocessing)
#install.packages("signal")
library(dplyr)
library(signal)
# 1. Design the High-Pass Filter
fs <- 100               # Sampling frequency from your .hea file
nyquist <- fs / 2       # Nyquist frequency is half the sampling rate
cutoff <- 0.5           # We want to remove frequencies below 0.5 Hz
# Normalize the cutoff frequency (required by the butter function)
W <- cutoff / nyquist
# Create a 3rd-order high-pass Butterworth filter
bw_filter <- butter(n = 3, W = W, type = "high")
# 2. Define your Tensor Dimensions
num_patients <- length(ecg_list)
timesteps <- 1200
num_leads <- 12
X_array <- array(0, dim = c(num_patients, timesteps, num_leads))
# 3. Populate the array WITH Baseline Wander Removal
for (i in 1:num_patients) {
# Extract the dataframe and drop the Time_s column
df <- ecg_list[[i]] %>% select(-Time_s)
# Create a temporary matrix to hold the filtered signals
filtered_matrix <- matrix(0, nrow = timesteps, ncol = num_leads)
# Apply the filter to each of the 12 leads individually
for (lead_idx in 1:num_leads) {
raw_signal <- df[[lead_idx]]
# We use 'filtfilt' instead of 'filter' for zero-phase distortion.
# This ensures the timing of the R-peaks doesn't shift left or right!
filtered_matrix[, lead_idx] <- filtfilt(bw_filter, raw_signal)
}
# Store the cleaned matrix into your 3D Keras tensor
X_array[i, , ] <- filtered_matrix
}
cat("Filtered X_array ready. Shape:", dim(X_array), "\n")
#----Plotting----
#Library for plotting
